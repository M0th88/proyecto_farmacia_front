{
  "name": "sistema-farmacia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "next dev",
    "prebuild": "npm run prisma:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "biome check --write --linter-enabled=false .",
    "format:check": "biome check --linter-enabled=false .",
    "typecheck": "tsc --noEmit",
    "check": "npm run prisma:validate:privada && npm run prisma:validate:asistencial && npm run typecheck && npm run lint",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:deploy": "npm run prisma:deploy:privada && npm run prisma:deploy:asistencial",
    "db:medicamentos:validar": "node prisma/import-medications.mjs --dry-run",
    "db:medicamentos:privada": "node prisma/import-medications.mjs --apply",
    "prisma:generate": "npm run prisma:generate:privada && npm run prisma:generate:asistencial",
    "prisma:generate:privada": "prisma generate --config prisma.privada.config.ts",
    "prisma:generate:asistencial": "prisma generate --config prisma.asistencial.config.ts",
    "prisma:validate:privada": "prisma validate --config prisma.privada.config.ts",
    "prisma:validate:asistencial": "prisma validate --config prisma.asistencial.config.ts",
    "prisma:migrate:privada": "prisma migrate dev --config prisma.privada.config.ts",
    "prisma:migrate:asistencial": "prisma migrate dev --config prisma.asistencial.config.ts",
    "prisma:deploy:privada": "prisma migrate deploy --config prisma.privada.config.ts",
    "prisma:deploy:asistencial": "prisma migrate deploy --config prisma.asistencial.config.ts",
    "prisma:studio:privada": "prisma studio --config prisma.privada.config.ts",
    "prisma:studio:asistencial": "prisma studio --config prisma.asistencial.config.ts",
    "admin:create:privada": "node scripts/create-private-admin.mjs",
    "demo:precios:privada": "node scripts/seed-private-demo-prices.mjs",
    "demo:pos:privada": "node scripts/seed-private-demo-pos.mjs",
    "import:medicamentos:chile": "node scripts/import-private-medicines-chile.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-switch": "1.2.6",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-query": "5.90.10",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "0.546.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.66.0",
    "sonner": "2.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@tailwindcss/turbopack": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
