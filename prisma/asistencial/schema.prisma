generator client {
  provider = "prisma-client"
  output   = "../../src/generated/asistencial"
}

datasource db {
  provider = "postgresql"
}

enum TipoUbicacion {
  BODEGA
  VITRINA
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
  TRASPASO
}

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  permisos    String[] @default([])

  usuarios Usuario[]

  creadoEn DateTime @default(now())
}

model Usuario {
  id       Int     @id @default(autoincrement())
  rut      String  @unique
  nombre   String
  apellido String?
  telefono String?
  email    String  @unique
  password String

  activo Boolean @default(true)

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([rolId])
}

model CategoriaMedicamento {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  medicamentos Medicamento[]
}

model Medicamento {
  id Int @id @default(autoincrement())

  codigoCatalogo String? @unique
  codigoAtc      String?
  fuenteCatalogo String?

  codigoBarra   String? @unique
  datosCatalogo Json?
  nombre        String

  principioActivo   String?
  concentracion     String?
  formaFarmaceutica String?

  precioVenta    Decimal?       @db.Decimal(12, 2)
  condicionVenta CondicionVenta @default(SIN_CLASIFICAR)
  stockMinimo    Int            @default(0)

  activo Boolean @default(true)

  categoriaId Int?

  categoria  CategoriaMedicamento?  @relation(fields: [categoriaId], references: [id])
  fichaChile FichaMedicamentoChile?

  lotes         Lote[]
  detallesVenta DetalleVenta[]
  programas     ProgramaMedicamento[]
  dispensados   DispensacionDetalle[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([nombre])
  @@index([categoriaId])
}

model FichaMedicamentoChile {
  id                       Int         @id @default(autoincrement())
  medicamentoId            Int         @unique
  medicamento              Medicamento @relation(fields: [medicamentoId], references: [id])
  grupoGeneral             String?
  subgrupoFarmacologico    String?
  mecanismoResumido        String?
  atcArchivo               String?
  productoIspEjemplo       String?
  nombreFantasia           String?
  laboratorioTitular       String?
  registroIsp              String?
  estadoIsp                String?
  fuenteIsp                String?
  observaciones            String?
  condicionVentaIsp        String?
  concentracionEjemplo     String?
  formaFarmaceuticaEjemplo String?
  viaAdministracion        String?
  tipoAlmacenamiento       String?
  condicionAlmacenamiento  String?
  actualizadoEn            DateTime    @updatedAt
}

model Lote {
  id Int @id @default(autoincrement())

  numeroLote String

  medicamentoId Int

  fechaFabricacion DateTime?
  fechaVencimiento DateTime

  medicamento Medicamento @relation(fields: [medicamentoId], references: [id])

  stocks        Stock[]
  movimientos   MovimientoStock[]
  detallesVenta DetalleVenta[]
  dispensados   DispensacionDetalle[]
  remesas       RemesaDetalle[]

  creadoEn DateTime @default(now())

  @@unique([medicamentoId, numeroLote])
  @@index([fechaVencimiento])
  @@index([medicamentoId])
}

enum MetodoPago {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

enum CondicionVenta {
  SIN_CLASIFICAR
  VENTA_DIRECTA
  RECETA_SIMPLE
  RECETA_RETENIDA
  RECETA_CHEQUE
}

enum TipoDocumentoVenta {
  BOLETA
  FACTURA
}

model Venta {
  id               Int                 @id @default(autoincrement())
  creadaEn         DateTime            @default(now())
  metodoPago       MetodoPago
  total            Decimal             @db.Decimal(12, 2)
  recibido         Decimal?            @db.Decimal(12, 2)
  vuelto           Decimal?            @db.Decimal(12, 2)
  claveOperacion   String?             @unique
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  descuento        Decimal             @default(0) @db.Decimal(12, 2)
  neto             Decimal?            @db.Decimal(12, 2)
  iva              Decimal?            @db.Decimal(12, 2)
  tipoDocumento    TipoDocumentoVenta?
  datosFacturacion Json?
  detalles         DetalleVenta[]

  @@index([creadaEn])
}

model DetalleVenta {
  id             Int         @id @default(autoincrement())
  ventaId        Int
  medicamentoId  Int
  loteId         Int
  cantidad       Int
  precioUnitario Decimal     @db.Decimal(12, 2)
  nombreProducto String?
  subtotal       Decimal     @db.Decimal(12, 2)
  venta          Venta       @relation(fields: [ventaId], references: [id])
  medicamento    Medicamento @relation(fields: [medicamentoId], references: [id])
  lote           Lote        @relation(fields: [loteId], references: [id])

  @@index([ventaId])
  @@index([medicamentoId])
  @@index([loteId])
}

model UbicacionInventario {
  id Int @id @default(autoincrement())

  nombre String

  tipo TipoUbicacion

  stocks Stock[]

  creadoEn DateTime @default(now())
}

model Stock {
  id Int @id @default(autoincrement())

  cantidadBloqueada Int              @default(0)
  cuarentenas       CasoCuarentena[]

  cantidad Int @default(0)

  loteId      Int
  ubicacionId Int

  lote Lote @relation(fields: [loteId], references: [id])

  ubicacion UbicacionInventario @relation(fields: [ubicacionId], references: [id])

  @@unique([loteId, ubicacionId])
  @@index([loteId])
  @@index([ubicacionId])
}

model CasoCuarentena {
  id               Int       @id @default(autoincrement())
  stockId          Int
  stock            Stock     @relation(fields: [stockId], references: [id])
  tipo             String
  cantidad         Int
  motivo           String
  registradoPor    Int
  creadoEn         DateTime  @default(now())
  resolucion       String?
  motivoResolucion String?
  resueltoPor      Int?
  resueltoEn       DateTime?

  @@index([tipo, resueltoEn])
  @@index([stockId])
}

model MovimientoStock {
  id Int @id @default(autoincrement())

  tipo     TipoMovimientoStock
  cantidad Int
  motivo   String?

  loteId Int

  lote Lote @relation(fields: [loteId], references: [id])

  creadoEn DateTime @default(now())

  @@index([loteId])
  @@index([creadoEn])
}

enum TipoPrograma {
  GES
  CRONICO
  OTRO
}

/// Programa de salud de la red pública (GES/AUGE, crónicos) que da derecho
/// a retirar medicamentos sin costo.
model ProgramaSalud {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique
  nombre      String
  tipo        TipoPrograma
  descripcion String?
  activo      Boolean      @default(true)
  creadoEn    DateTime     @default(now())

  medicamentos   ProgramaMedicamento[]
  inscripciones  InscripcionPrograma[]
  dispensaciones Dispensacion[]
}

/// Medicamento cubierto por un programa y unidades máximas por paciente al mes.
model ProgramaMedicamento {
  programaId    Int
  medicamentoId Int
  cuotaMensual  Int

  programa    ProgramaSalud @relation(fields: [programaId], references: [id], onDelete: Cascade)
  medicamento Medicamento   @relation(fields: [medicamentoId], references: [id])

  @@id([programaId, medicamentoId])
  @@index([medicamentoId])
}

model Paciente {
  id              Int       @id @default(autoincrement())
  rut             String    @unique
  nombre          String
  fechaNacimiento DateTime? @db.Date
  telefono        String?
  direccion       String?
  /// FONASA, ISAPRE, CAPREDENA, DIPRECA o PARTICULAR.
  prevision       String?
  /// Tramo Fonasa: A, B, C o D (solo si la previsión es FONASA).
  tramoFonasa     String?
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  inscripciones  InscripcionPrograma[]
  dispensaciones Dispensacion[]
}

model InscripcionPrograma {
  id         Int       @id @default(autoincrement())
  pacienteId Int
  programaId Int
  desde      DateTime  @db.Date
  hasta      DateTime? @db.Date
  activo     Boolean   @default(true)
  creadoEn   DateTime  @default(now())

  paciente Paciente      @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  programa ProgramaSalud @relation(fields: [programaId], references: [id])

  @@unique([pacienteId, programaId])
  @@index([programaId])
}

/// Entrega sin costo a un paciente inscrito. Si retira un tercero queda
/// registrado su RUT, nombre y parentesco.
model Dispensacion {
  id               Int      @id @default(autoincrement())
  claveOperacion   String   @unique
  pacienteId       Int
  programaId       Int
  folioReceta      String?
  medicoRut        String
  medicoNombre     String
  fechaReceta      DateTime @db.Date
  retiraRut        String?
  retiraNombre     String?
  retiraParentesco String?
  observaciones    String?
  usuarioId        Int?
  creadaEn         DateTime @default(now())

  paciente Paciente              @relation(fields: [pacienteId], references: [id])
  programa ProgramaSalud         @relation(fields: [programaId], references: [id])
  detalles DispensacionDetalle[]

  @@index([pacienteId, creadaEn])
  @@index([creadaEn])
}

model DispensacionDetalle {
  id             Int @id @default(autoincrement())
  dispensacionId Int
  medicamentoId  Int
  loteId         Int
  ubicacionId    Int
  cantidad       Int

  dispensacion Dispensacion @relation(fields: [dispensacionId], references: [id], onDelete: Cascade)
  medicamento  Medicamento  @relation(fields: [medicamentoId], references: [id])
  lote         Lote         @relation(fields: [loteId], references: [id])

  @@index([dispensacionId])
  @@index([medicamentoId])
}

/// Recepción de una remesa (por defecto CENABAST) con su guía de despacho.
model Remesa {
  id            Int      @id @default(autoincrement())
  guia          String
  proveedor     String   @default("CENABAST")
  recibidaEn    DateTime @default(now())
  observaciones String?
  usuarioId     Int?

  detalles RemesaDetalle[]

  @@unique([proveedor, guia])
}

model RemesaDetalle {
  id          Int @id @default(autoincrement())
  remesaId    Int
  loteId      Int
  ubicacionId Int
  cantidad    Int

  remesa Remesa @relation(fields: [remesaId], references: [id], onDelete: Cascade)
  lote   Lote   @relation(fields: [loteId], references: [id])

  @@index([remesaId])
}
