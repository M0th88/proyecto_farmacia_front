generator client {
  provider = "prisma-client"
  output   = "../../src/generated/privada"
}

datasource db {
  provider = "postgresql"
}

enum TipoUbicacion {
  BODEGA
  VITRINA
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
  TRASPASO
}

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  permisos    String[] @default([])

  usuarios Usuario[]

  creadoEn DateTime @default(now())
}

model Usuario {
  id       Int     @id @default(autoincrement())
  rut      String  @unique
  nombre   String
  apellido String?
  telefono String?
  email    String  @unique
  password String

  activo Boolean @default(true)

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([rolId])
}

model CategoriaMedicamento {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  medicamentos Medicamento[]
}

model Medicamento {
  id Int @id @default(autoincrement())

  codigoCatalogo String? @unique
  codigoAtc      String?
  fuenteCatalogo String?

  codigoBarra   String? @unique
  datosCatalogo Json?
  nombre        String

  principioActivo   String?
  concentracion     String?
  formaFarmaceutica String?

  precioVenta    Decimal?       @db.Decimal(12, 2)
  condicionVenta CondicionVenta @default(SIN_CLASIFICAR)
  stockMinimo    Int            @default(0)

  activo Boolean @default(true)

  categoriaId Int?

  categoria  CategoriaMedicamento?  @relation(fields: [categoriaId], references: [id])
  fichaChile FichaMedicamentoChile?

  lotes         Lote[]
  detallesVenta DetalleVenta[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([nombre])
  @@index([categoriaId])
}

model FichaMedicamentoChile {
  id                       Int         @id @default(autoincrement())
  medicamentoId            Int         @unique
  medicamento              Medicamento @relation(fields: [medicamentoId], references: [id])
  grupoGeneral             String?
  subgrupoFarmacologico    String?
  mecanismoResumido        String?
  atcArchivo               String?
  productoIspEjemplo       String?
  nombreFantasia           String?
  laboratorioTitular       String?
  registroIsp              String?
  estadoIsp                String?
  fuenteIsp                String?
  observaciones            String?
  condicionVentaIsp        String?
  concentracionEjemplo     String?
  formaFarmaceuticaEjemplo String?
  viaAdministracion        String?
  tipoAlmacenamiento       String?
  condicionAlmacenamiento  String?
  actualizadoEn            DateTime    @updatedAt
}

model Lote {
  id Int @id @default(autoincrement())

  numeroLote String

  medicamentoId Int

  fechaFabricacion DateTime?
  fechaVencimiento DateTime

  medicamento Medicamento @relation(fields: [medicamentoId], references: [id])

  stocks        Stock[]
  movimientos   MovimientoStock[]
  detallesVenta DetalleVenta[]

  creadoEn DateTime @default(now())

  @@unique([medicamentoId, numeroLote])
  @@index([fechaVencimiento])
  @@index([medicamentoId])
}

enum MetodoPago {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

enum CondicionVenta {
  SIN_CLASIFICAR
  VENTA_DIRECTA
  RECETA_SIMPLE
  RECETA_RETENIDA
  RECETA_CHEQUE
}

model Venta {
  id         Int            @id @default(autoincrement())
  creadaEn   DateTime       @default(now())
  metodoPago MetodoPago
  total      Decimal        @db.Decimal(12, 2)
  recibido   Decimal?       @db.Decimal(12, 2)
  vuelto     Decimal?       @db.Decimal(12, 2)
  detalles   DetalleVenta[]

  @@index([creadaEn])
}

model DetalleVenta {
  id             Int         @id @default(autoincrement())
  ventaId        Int
  medicamentoId  Int
  loteId         Int
  cantidad       Int
  precioUnitario Decimal     @db.Decimal(12, 2)
  subtotal       Decimal     @db.Decimal(12, 2)
  venta          Venta       @relation(fields: [ventaId], references: [id])
  medicamento    Medicamento @relation(fields: [medicamentoId], references: [id])
  lote           Lote        @relation(fields: [loteId], references: [id])

  @@index([ventaId])
  @@index([medicamentoId])
  @@index([loteId])
}

model UbicacionInventario {
  id Int @id @default(autoincrement())

  nombre String

  tipo TipoUbicacion

  stocks Stock[]

  creadoEn DateTime @default(now())
}

model Stock {
  id Int @id @default(autoincrement())

  cantidad Int @default(0)

  loteId      Int
  ubicacionId Int

  lote Lote @relation(fields: [loteId], references: [id])

  ubicacion UbicacionInventario @relation(fields: [ubicacionId], references: [id])

  @@unique([loteId, ubicacionId])
  @@index([loteId])
  @@index([ubicacionId])
}

model MovimientoStock {
  id Int @id @default(autoincrement())

  tipo     TipoMovimientoStock
  cantidad Int
  motivo   String?

  loteId Int

  lote Lote @relation(fields: [loteId], references: [id])

  creadoEn DateTime @default(now())

  @@index([loteId])
  @@index([creadoEn])
}
